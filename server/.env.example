# ---- Server ----
# Port the Express API listens on
PORT=4000
# Node environment: development | production
NODE_ENV=development

# ---- Database ----
# MongoDB connection string.
# Local Docker (see docker-compose.yml): mongodb://localhost:27017/doctor_tracker
# MongoDB Atlas example:                 mongodb+srv://<user>:<pass>@<cluster>/doctor_tracker
MONGODB_URI=mongodb://localhost:27017/doctor_tracker

# ---- Auth ----
# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=change_me_to_a_long_random_secret
# How long an access token stays valid
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Allowed browser origin(s) of the Next.js client, comma-separated.
# Local:       http://localhost:3000
# Production:  https://your-app.vercel.app
# Both:        https://your-app.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000

# ---- Seed admin account ----
# Credentials created by `npm run seed`
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@12345
